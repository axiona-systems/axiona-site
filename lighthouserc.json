{
  "ci": {
    "collect": {
      "staticDistDir": "./",
      "url": [
        "http://localhost/",
        "http://localhost/systems.html",
        "http://localhost/process.html",
        "http://localhost/security.html",
        "http://localhost/solutions.html",
        "http://localhost/keeper.html",
        "http://localhost/contact.html",
        "http://localhost/support.html",
        "http://localhost/privacy.html",
        "http://localhost/legal.html",
        "http://localhost/en/",
        "http://localhost/de/"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--headless --no-sandbox --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", {"minScore": 0.80}],
        "categories:accessibility": ["error", {"minScore": 0.90}],
        "categories:best-practices": ["error", {"minScore": 0.90}],
        "categories:seo": ["error", {"minScore": 0.90}]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
