{
  "ci": {
    "collect": {
      "staticDistDir": "./",
      "url": [
        "http://localhost/",
        "http://localhost/kockalmar/",
        "http://localhost/fejtorpe/",
        "http://localhost/keeper/",
        "http://localhost/egyuttmukodes/",
        "http://localhost/hogyan-keszul/",
        "http://localhost/naplo/",
        "http://localhost/otletlada/",
        "http://localhost/rolam/",
        "http://localhost/kapcsolat/"
      ],
      "numberOfRuns": 1,
      "settings": {
        "chromeFlags": "--headless --no-sandbox --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          {
            "minScore": 0.8
          }
        ],
        "categories:accessibility": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:best-practices": [
          "error",
          {
            "minScore": 0.9
          }
        ],
        "categories:seo": [
          "error",
          {
            "minScore": 0.9
          }
        ]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/reports"
    }
  }
}
